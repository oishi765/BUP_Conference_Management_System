PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Keep true unless the selected endpoint explicitly requires relaxed certificate verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Private Supabase Storage bucket credentials (server only; never use VITE_ prefix).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-service-role-secret
SUPABASE_STORAGE_BUCKET=manuscripts
MANUSCRIPT_MAX_BYTES=15728640
MANUSCRIPT_SIGNED_URL_SECONDS=300
# Generate independent random secrets of at least 32 bytes for production.
CSRF_SECRET=replace-with-a-different-long-random-secret
AUTH_REQUIRE_EMAIL_VERIFICATION=false
SESSION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
# Optional SMTP email provider. If unset, password reset and verification emails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BUP Conference Management <no-reply@example.org>
# Set only when behind a known reverse proxy.
TRUST_PROXY_HOPS=0
